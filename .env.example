# Copia questo file in `.env.local` e valorizza le variabili.
# `.env.local` NON deve mai essere committato.
#
# ─── Questo file è per lo SVILUPPO LOCALE ─────────────────────────────────────
#
# Non copiarlo dentro Vercel. In produzione servono solo le variabili che il
# codice legge davvero, inserite una per una:
#
#   DATABASE_URL      obbligatoria — connessione pooled a Neon
#   AUTH_SECRET       obbligatoria — valore NUOVO, mai lo stesso dello sviluppo
#   AUTH_GITHUB_ID    facoltativa — solo per il pulsante «Continua con GitHub»
#   AUTH_GITHUB_SECRET
#   LOG_LEVEL         facoltativa — se vuota vale `info` in produzione
#
# Tutte le altre servono a traguardi futuri (T3 per il modello linguistico, T5
# per i job) e finché non esiste il codice che le legge restano ignorate.
#
# Un `AUTH_SECRET` condiviso fra il portatile di uno sviluppatore e la
# produzione significa che un portatile compromesso permette di falsificare le
# sessioni dell'ambiente reale.
#
# Procedura completa: docs/messa-in-linea.md
# ──────────────────────────────────────────────────────────────────────────────

# --- Database (Neon) ---
# Stringa di connessione Postgres per l'applicazione: usa la connessione "pooled"
# (l'host contiene `-pooler`). Necessaria in ambiente serverless, dove ogni
# invocazione aprirebbe altrimenti una connessione propria fino a esaurire il limite.
DATABASE_URL=

# Stringa di connessione **diretta** (host senza `-pooler`), usata solo dalle
# migrazioni. Il pooler lavora in transaction mode e restituisce la connessione al
# termine di ogni transazione: SET, tabelle temporanee, PREPARE e lock di sessione
# non sopravvivono. Gli strumenti di migrazione ne hanno bisogno.
DATABASE_URL_UNPOOLED=

# --- Autenticazione (Auth.js) ---
# Genera con: node scripts/generate-secrets.mjs
AUTH_SECRET=

# AUTH_URL è deliberatamente assente, e non va aggiunta.
#
# La configurazione usa `trustHost: true`: Auth.js ricava l'indirizzo dalla
# richiesta, quindi funziona identica su localhost, sui deploy di anteprima e in
# produzione, che hanno indirizzi diversi. Se invece la variabile è presente,
# **vince lei**: copiare questo file su Vercel con un valore `localhost`
# rimanderebbe lì ogni utente appena autenticato. La sessione verrebbe creata
# correttamente, quindi dal lato server non sembrerebbe rotto nulla — la persona
# atterrerebbe semplicemente su un indirizzo che in produzione non esiste.
#
# Impostala solo se ti serve forzare un indirizzo diverso da quello della
# richiesta, e allora sappi esattamente perché.

# OAuth GitHub (opzionale in sviluppo)
# In produzione serve una seconda applicazione: un'app OAuth accetta un solo URL
# di ritorno, quindi quella di sviluppo non vale online.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Modello linguistico ---
# Provider attivo: gemini | groq | fake
# In sviluppo e nei test usa "fake": nessuna chiamata di rete, nessun costo.
LLM_PROVIDER=fake

# Una chiave per provider, non una sola condivisa: ADR-0005 prevede Gemini primario
# e Groq di riserva, e una riserva che richiede di riscrivere a mano la chiave non è
# una riserva. Il gateway in src/lib/llm sceglie la chiave in base al provider.
# Valorizza solo quelle che possiedi: le altre restano vuote.
GEMINI_API_KEY=
GROQ_API_KEY=

# Modello da usare, facoltativo: se vuoto il gateway applica il proprio valore
# predefinito per il provider attivo.
LLM_MODEL=

# --- Osservabilità ---
# Livello minimo dei log emessi da src/lib/logger: debug | info | warn | error.
# Se vuoto: "debug" in sviluppo, "info" in produzione. Non è un segreto.
LOG_LEVEL=

# --- Job schedulati ---
# Segreto condiviso che protegge le route dei job. Genera un valore casuale lungo.
JOB_SECRET=

# Upstash QStash (invocazione dei job schedulati)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
