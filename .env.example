# Copia questo file in `.env.local` e valorizza le variabili.
# `.env.local` NON deve mai essere committato.
#
# ─── Questo file è per lo SVILUPPO LOCALE ─────────────────────────────────────
#
# Non copiarlo dentro Vercel. In produzione servono solo le variabili che il
# codice legge davvero, inserite una per una:
#
#   DATABASE_URL      obbligatoria — connessione pooled a Neon
#   AUTH_SECRET       obbligatoria — valore NUOVO, mai lo stesso dello sviluppo
#   AUTH_GITHUB_ID    facoltativa — solo per il pulsante «Continua con GitHub»
#   AUTH_GITHUB_SECRET
#   LOG_LEVEL         facoltativa — se vuota vale `info` in produzione
#
# Tutte le altre servono a traguardi futuri (T3 per il modello linguistico, T5
# per i job) e finché non esiste il codice che le legge restano ignorate.
#
# Un `AUTH_SECRET` condiviso fra il portatile di uno sviluppatore e la
# produzione significa che un portatile compromesso permette di falsificare le
# sessioni dell'ambiente reale.
#
# Procedura completa: docs/messa-in-linea.md
# ──────────────────────────────────────────────────────────────────────────────

# --- Database (Neon) ---
# Stringa di connessione Postgres per l'applicazione: usa la connessione "pooled"
# (l'host contiene `-pooler`). Necessaria in ambiente serverless, dove ogni
# invocazione aprirebbe altrimenti una connessione propria fino a esaurire il limite.
DATABASE_URL=

# Stringa di connessione **diretta** (host senza `-pooler`), usata solo dalle
# migrazioni. Il pooler lavora in transaction mode e restituisce la connessione al
# termine di ogni transazione: SET, tabelle temporanee, PREPARE e lock di sessione
# non sopravvivono. Gli strumenti di migrazione ne hanno bisogno.
DATABASE_URL_UNPOOLED=

# --- Autenticazione (Auth.js) ---
# Genera con: node scripts/generate-secrets.mjs
AUTH_SECRET=

# --- Custodia dei segreti dei clienti ---
# Chiave principale con cui si cifrano i segreti che i clienti affidano al
# portale: la chiave del loro modello linguistico e il token del loro Jira
# (ADR-0010).
#
# **Trentadue byte in base64, non uno di meno.** Il modulo che la legge rifiuta
# qualunque altra lunghezza invece di allungarla: una passphrase stirata a forza
# sembra una chiave a 256 bit e porta la robustezza della passphrase.
#
# Si genera insieme alle altre con `node scripts/generate-secrets.mjs`.
#
# **Perderla significa perdere ogni segreto già cifrato.** Non sono recuperabili:
# vanno reinserite le chiavi, una per progetto. Cambiarla ha lo stesso effetto,
# e lo strumento che ricifra le righe **non esiste ancora** (debito registrato).
#
# In produzione va inserita a mano fra le variabili di Vercel, e deve essere
# **diversa** da quella di sviluppo per la stessa ragione di AUTH_SECRET.
SECRETS_KEY=

# AUTH_URL è deliberatamente assente, e non va aggiunta.
#
# La configurazione usa `trustHost: true`: Auth.js ricava l'indirizzo dalla
# richiesta, quindi funziona identica su localhost, sui deploy di anteprima e in
# produzione, che hanno indirizzi diversi. Se invece la variabile è presente,
# **vince lei**: copiare questo file su Vercel con un valore `localhost`
# rimanderebbe lì ogni utente appena autenticato. La sessione verrebbe creata
# correttamente, quindi dal lato server non sembrerebbe rotto nulla — la persona
# atterrerebbe semplicemente su un indirizzo che in produzione non esiste.
#
# Impostala solo se ti serve forzare un indirizzo diverso da quello della
# richiesta, e allora sappi esattamente perché.

# OAuth GitHub (opzionale in sviluppo)
# In produzione serve una seconda applicazione: un'app OAuth accetta un solo URL
# di ritorno, quindi quella di sviluppo non vale online.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Modello linguistico: SOLO per `npm run eval` ---
#
# ATTENZIONE, è la domanda che fanno tutti: queste variabili **non configurano
# il modello del portale**, né in produzione né sul portatile. Impostarle non ha
# alcun effetto sullo Scrum Master AI.
#
# Il modello di un progetto si sceglie dalla scheda «Modello» delle sue
# impostazioni, e la chiave la porta chi usa il portale: vive cifrata nel
# database, per progetto (ADR-0010). Non esiste un modello dell'applicazione —
# un gateway condiviso servirebbe il rapporto di un'azienda con la chiave di
# un'altra, e nessun test se ne accorgerebbe perché il testo sarebbe corretto.
#
# Restano qui per l'unico chiamante che non ha un progetto da cui prendere una
# chiave: il runner delle valutazioni (`npm run eval`), che gira da riga di
# comando fuori da qualsiasi richiesta.
#
# Provider per le valutazioni: gemini | openai | anthropic | mistral | groq |
# openrouter | ollama | fake. Con "fake" le valutazioni non misurano nulla e il
# runner lo dice.
LLM_PROVIDER=fake

# Una chiave per provider, non una sola condivisa: ADR-0005 prevede Gemini
# primario e Groq di riserva, e una riserva che richiede di riscrivere a mano la
# chiave non è una riserva.
# Valorizza solo quelle che possiedi: le altre restano vuote.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Modello e indirizzo alternativo per le valutazioni, facoltativi.
# Se vuoti si applica il valore predefinito del provider scelto.
LLM_MODEL=
LLM_BASE_URL=

# --- Osservabilità ---
# Livello minimo dei log emessi da src/lib/logger: debug | info | warn | error.
# Se vuoto: "debug" in sviluppo, "info" in produzione. Non è un segreto.
LOG_LEVEL=

# --- Job schedulati ---
# Segreto condiviso che protegge le route dei job. Genera un valore casuale lungo.
JOB_SECRET=

# Upstash QStash (invocazione dei job schedulati)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Connettore Jira Cloud ---
# Credenziali di sola lettura verso un'istanza Jira Cloud (ADR-0009).
#
# Il token si genera su https://id.atlassian.com/manage/api-tokens ed è personale:
# vale quanto la password dell'account, e va trattato come tale. Il connettore non
# scrive mai su Jira, ma il token non lo sa — chi lo ottiene può.
#
# L'email è quella dell'account Atlassian a cui il token appartiene: Jira usa la
# coppia, non il solo token.
#
# Il resto della configurazione (dominio del sito, chiave del progetto, board,
# mappatura degli stati) **non** sta qui: dipende dal progetto, non dalla
# macchina, e vive nel database.
JIRA_EMAIL=
JIRA_API_TOKEN=
