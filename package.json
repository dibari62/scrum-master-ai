{
  "name": "scrum-master-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run test && npm run boundaries",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e",
    "eval": "node scripts/not-implemented.mjs eval",
    "db:generate": "node scripts/not-implemented.mjs db:generate",
    "db:migrate": "node scripts/not-implemented.mjs db:migrate",
    "seed": "node scripts/not-implemented.mjs seed",
    "build": "node node_modules/next/dist/bin/next build",
    "dev": "node node_modules/next/dist/bin/next dev",
    "start": "node node_modules/next/dist/bin/next start",
    "boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
